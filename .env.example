# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Both values come from the Storyblok space at app.storyblok.com.
# The space is in the EU region, so the API host is api.storyblok.com.

# Settings > Access Tokens. Must be a *Preview* token, not Public — the build
# reads drafts so an unpublished post can be checked locally before it ships.
# Read-only and scoped to one space.
STORYBLOK_TOKEN=

# Settings > Space. Only needed for the Management API and the visual editor;
# the content fetch identifies the space from the token alone.
STORYBLOK_SPACE_ID=
