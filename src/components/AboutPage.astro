---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Skills from './sections/Skills.astro';
import Contact from './sections/Contact.astro';
import Footer from './Footer.astro';
import { location, shared } from '../content/shared';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

const copy: Record<Locale, { title: string; description: string; where: string; intro: string }> = {
	en: {
		title: 'About — Felipe Manchester',
		description: 'Full-stack developer based in Brazil, working across React, Next.js and Astro.',
		where: 'Based in',
		// Placeholder copy — meant to be rewritten.
		intro:
			'Most of what I do is invisible when it works: pages that load before anyone notices, layouts that hold up on the fifth screen size, code the next person can actually read. I like working close to the design, not just implementing it.',
	},
	pt: {
		title: 'Sobre — Felipe Manchester',
		description:
			'Desenvolvedor full-stack no Brasil, trabalhando com React, Next.js e Astro.',
		where: 'Baseado em',
		intro:
			'A maior parte do que eu faço é invisível quando funciona: páginas que carregam antes de alguém notar, layouts que se sustentam na quinta tela diferente, código que a próxima pessoa consegue ler de fato. Gosto de trabalhar perto do design, não só implementá-lo.',
	},
};

const { locale } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />

	<section
		class="relative z-1 mx-auto max-w-page px-frame pt-page-top pb-[clamp(3rem,8vh,5rem)]"
		id="main"
		aria-labelledby="about-page-label"
	>
		{/* The hairline drops to its own row once the two labels stop fitting beside it. */}
		<header class="flex items-center gap-3.5 max-[560px]:flex-wrap max-[560px]:gap-y-2">
			<h1
				class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
				id="about-page-label"
			>
				{t.aboutLabel}
			</h1>
			<span class="h-px flex-1 bg-line max-[560px]:order-3 max-[560px]:basis-full" aria-hidden="true"
			></span>
			<span
				class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
			>
				{t.where} — {location.label}
			</span>
		</header>

		<p
			class="mt-flow-md max-w-[22ch] text-about-lead leading-[1.1] font-semibold tracking-[-0.03em] text-balance"
		>
			{t.aboutBody}
		</p>
		<p class="mt-flow-sm max-w-[54ch] text-prose leading-[1.65] text-muted text-pretty">
			{t.intro}
		</p>
	</section>

	<Skills locale={locale} />
	<Contact locale={locale} />
	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initMagnetic } from '../scripts/magnetic';
	import { initMotion } from '../scripts/motion';

	initTheme();
	initNav();
	initMagnetic();
	initMotion();
</script>
