---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Skills from './sections/Skills.astro';
import Contact from './sections/Contact.astro';
import Footer from './Footer.astro';
import { shared } from '../content/shared';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

const copy: Record<Locale, { title: string; description: string; intro: string[] }> = {
	en: {
		title: 'About — Felipe Manchester',
		description: 'Full-stack developer based in Brazil, working across React, Next.js and Astro.',
		// Each entry is its own paragraph, rendered with set:html for the <strong> spans.
		intro: [
			'Hi!',
			'My name is Felipe Manchester. I\'m a <strong>full-stack developer</strong> with a strong front-end background. I like turning ideas into well-built applications, always paying attention to accessibility, performance, SEO and code quality.',
			'I like understanding the problem before I start building. The better I understand the product, the more carefully I can think about the experience of whoever is going to use it. I believe a good site needs to be <strong>fast, easy to use and simple to evolve</strong>.',
			'I\'m also always learning. Whenever I come across a new technology, tool or concept that could improve the quality of my work, I study it, test it, and figure out how it actually works. That curiosity is part of how I work.',
			'A few people have inspired me since I first got into tech — <strong>Mayk Brito, André Rafael, Zeno Rocha and Fábio Akita</strong>. Their content shaped a lot of my growth as a developer, and still does.',
		],
	},
	pt: {
		title: 'Sobre — Felipe Manchester',
		description:
			'Desenvolvedor full-stack no Brasil, trabalhando com React, Next.js e Astro.',
		intro: [
			'Olá!',
			'Meu nome é Felipe Manchester. Sou <strong>desenvolvedor full-stack</strong>, com uma forte base em front-end. Gosto de criar e transformar ideias em aplicações bem construídas. Sempre dou atenção à acessibilidade, à performance, ao SEO e à qualidade do código.',
			'Gosto de entender o problema antes de começar a desenvolver. Compreendendo melhor o produto, consigo pensar com mais cuidado na experiência de quem vai usá-lo. Acredito que um bom site precisa ser <strong>rápido, fácil de usar e simples de evoluir</strong>.',
			'Também gosto de aprender continuamente. Sempre que encontro uma tecnologia, ferramenta ou conceito novo que possa melhorar a qualidade do meu trabalho, procuro estudar, testar e entender como tudo funciona. Essa curiosidade faz parte da forma como trabalho.',
			'Tenho algumas referências que me inspiram desde que comecei a me interessar por tecnologia, como <strong>Mayk Brito, André Rafael, Zeno Rocha e Fábio Akita</strong>. O conteúdo dessas pessoas contribuiu muito para a minha formação e continua me ajudando a evoluir como desenvolvedor.',
		],
	},
};

const { locale } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />

	<section
		class="relative z-1 mx-auto max-w-page px-frame pt-page-top pb-[clamp(3rem,8vh,5rem)]"
		id="main"
		aria-labelledby="about-page-label"
	>
		{/* The hairline drops to its own row once the two labels stop fitting beside it. */}
		<header class="flex items-center gap-3.5 max-[560px]:flex-wrap max-[560px]:gap-y-2">
			<h1
				class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
				id="about-page-label"
			>
				{t.aboutLabel}
			</h1>
			<span class="h-px flex-1 bg-line max-[560px]:order-3 max-[560px]:basis-full" aria-hidden="true"
			></span>
		</header>

		<div class="mx-auto mt-flow-md max-w-4xl text-left">
			<div class="space-y-4 text-prose leading-[1.65] text-muted text-pretty">
				{t.intro.map((paragraph) => <p set:html={paragraph} />)}
			</div>
		</div>
	</section>

	<Skills locale={locale} />
	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initMagnetic } from '../scripts/magnetic';
	import { initMotion } from '../scripts/motion';

	initTheme();
	initNav();
	initMagnetic();
	initMotion();
</script>
