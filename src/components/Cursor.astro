---
/**
 * Custom pointer: an arrow glyph that tracks the cursor 1:1 and grows over
 * anything clickable. No lag, no rAF loop — position is set straight off
 * `pointermove`, since the native cursor already has zero latency and a
 * smoothed follower would only make this one feel slower by comparison.
 */
---

<div class="cursor" data-cursor aria-hidden="true">
	{/*
	  fill:currentColor themes with --fg; the stroke is the same halo trick the
	  earlier ring used — without it, this arrow disappears over anything the
	  same colour as --fg, which includes the primary CTA's own background.
	*/}
	<svg class="cursor__glyph" viewBox="0 0 24 24" width="20" height="20">
		<path
			d="M4.5.79v22.42l6.56-6.57h9.29L4.5.79z"
			fill="currentColor"
			stroke="var(--bg)"
			stroke-width="2"
			stroke-linejoin="round"
		/>
	</svg>
</div>

<script>
	import { initCursor } from '../scripts/cursor';

	const ring = document.querySelector<HTMLElement>('[data-cursor]');
	if (ring) initCursor(ring);
</script>

<style>
	.cursor {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 100;
		/* Shifts the box so the arrow's own tip (near 4.5,0.79 in its 24-unit
		   viewBox, scaled to this 20px render) lands on the real pointer position,
		   rather than the box's own corner or centre. */
		margin: -1px 0 0 -4px;
		color: var(--fg);
		pointer-events: none;
		opacity: 0;
		scale: 1;
		transform-origin: 4px 1px;
		transition:
			scale 220ms var(--ease-out-quart),
			color 220ms var(--ease-out-quart),
			opacity 200ms linear;
	}

	.cursor[data-visible] {
		opacity: 1;
	}

	.cursor.is-active {
		color: var(--accent);
		scale: 1.3;
	}

	.cursor.is-pressed {
		scale: 0.85;
	}

	.cursor__glyph {
		display: block;
	}
</style>
