---
/**
 * Background layer 4. The canvas ships empty and stays empty unless the
 * device can afford it — every guard below is a case where the effect would
 * cost more than it returns.
 */
---

<canvas class="mesh" data-mesh aria-hidden="true"></canvas>

<script>
	import { initPointer } from '../../scripts/pointer';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-mesh]');

	function meshIsWorthIt(): boolean {
		if (!canvas) return false;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
		// Fewer than 4 cores usually means a low-end phone, where this is the
		// first thing that would drop frames.
		if ((navigator.hardwareConcurrency ?? 8) < 4) return false;
		// Small screens only: the layer costs battery there and the viewport is
		// too tight for it to read. Deliberately not gated on `pointer: fine` —
		// the field breathes on its own and the cursor only deflects it, so a
		// keyboard-only desktop visitor should still get the layer.
		if (window.innerWidth < 720) return false;
		return true;
	}

	function start(): void {
		if (!canvas || !meshIsWorthIt()) return;
		initPointer();
		// Kept out of the critical path entirely: the shader module is only
		// fetched once the page has finished loading and the main thread idles.
		import('../../scripts/mesh')
			.then(({ initMesh }) => initMesh(canvas))
			.catch(() => {
				/* Layers 1–3 already carry the page. */
			});
	}

	function whenIdle(): void {
		if (typeof window.requestIdleCallback === 'function') {
			window.requestIdleCallback(start, { timeout: 2000 });
		} else {
			window.setTimeout(start, 200);
		}
	}

	if (document.readyState === 'complete') whenIdle();
	else window.addEventListener('load', whenIdle, { once: true });
</script>

<style>
	.mesh {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: var(--mesh-opacity);
		transition: opacity 400ms linear;
	}
</style>
