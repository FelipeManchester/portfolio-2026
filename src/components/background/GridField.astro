---
/**
 * Background layer 3 — the drafting grid.
 *
 * Sits between the grain and the WebGL mesh. Unlike the mesh, this layer is not
 * conditional: the grid is part of the drawing, so it renders on every device.
 * Only the cursor lens is gated, inside grid.ts.
 */
---

<canvas class="grid-field" data-grid-field aria-hidden="true"></canvas>

<script>
	import { initPointer } from '../../scripts/pointer';
	import { initGrid } from '../../scripts/grid';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-grid-field]');
	if (canvas) {
		// The lens reads the shared smoothed pointer. initPointer guards itself,
		// so it does not matter whether the mesh got there first.
		initPointer();
		initGrid(canvas);
	}
</script>

<style>
	.grid-field {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: var(--grid-opacity);
	}
</style>
