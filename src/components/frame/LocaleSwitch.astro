---
import { copy, locales, type Locale } from '../../content/site';
import { localePath } from '../../lib/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const pathname = Astro.url.pathname;
---

{/* The frame itself is click-through; these links must not be. */}
<nav
	class="animate-annotation pointer-events-auto inline-flex items-center gap-2"
	aria-label={t.localeLabel}
>
	{
		locales.map((code, index) => (
			<>
				{index > 0 && <span class="h-2.75 w-px bg-line" aria-hidden="true" />}
				{/*
				  The active language is stated by aria-current for assistive tech and
				  by full contrast for everyone else.
				*/}
				<a
					class="font-mono text-mono tracking-mono text-muted no-underline transition-colors duration-180 ease-linear hover:text-fg aria-current:text-fg"
					href={localePath(pathname, code)}
					hreflang={code}
					lang={code}
					aria-current={code === locale ? 'true' : undefined}
				>
					{code.toUpperCase()}
				</a>
			</>
		))
	}
</nav>
