---
import LocalTime from './LocalTime.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
---

{/*
  The drafting frame: local time top-left, language switch top-right. Not
  aria-hidden as a whole: it holds a real navigation landmark and a genuine
  piece of information. Only the hairline is decorative.

  Click-through so the frame never steals events from the hero; the language
  links opt back in themselves.
*/}
<div
	class="pointer-events-none fixed inset-frame z-2 transition-[translate] duration-300 ease-quart data-hidden:-translate-y-[calc(100%+1.5rem)]"
	data-frame
>
	<div class="flex items-center gap-3.5">
		<span
			class="animate-annotation m-0 font-mono text-mono tracking-mono whitespace-nowrap text-muted uppercase"
		>
			<LocalTime locale={locale} />
		</span>
		<span class="animate-rule-draw h-px flex-1 origin-left bg-line" aria-hidden="true"></span>
		<LocaleSwitch locale={locale} />
	</div>
</div>
