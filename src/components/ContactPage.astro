---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Footer from './Footer.astro';
import { email, shared, socials } from '../content/shared';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

const copy: Record<Locale, { title: string; description: string; socialsLabel: string }> = {
	en: {
		title: 'Contact | Felipe Manchester',
		description:
			'Get in touch for freelance projects, job opportunities, or to talk about web development. I answer every message by email.',
		socialsLabel: 'Elsewhere',
	},
	pt: {
		title: 'Contato | Felipe Manchester',
		description:
			'Entre em contato para projetos freelance, oportunidades de trabalho ou para conversar sobre desenvolvimento web. Respondo todas as mensagens por e-mail.',
		socialsLabel: 'Outros lugares',
	},
};

const { locale } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />

	<main
		class="relative z-1 mx-auto max-w-page px-frame pt-page-top pb-section"
		id="main"
		aria-labelledby="contact-page-label"
	>
		<header class="flex items-center gap-3.5">
			<h1
				class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
				id="contact-page-label"
			>
				{t.contactLabel}
			</h1>
		</header>

		<p
			class="mt-flow-lg max-w-[20ch] text-statement leading-[0.95] font-semibold tracking-[-0.045em] text-balance"
		>
			{t.contactHeadline}
		</p>
		<p class="mt-flow-sm max-w-[44ch] leading-[1.65] text-muted text-pretty text-xl">{t.contactBody}</p>

		{/*
		  The address is set larger than the section body and written out in full:
		  a recruiter who wants to paste it into their own client should not have
		  to hunt for it.
		*/}
		<a
			class="group/mail mt-flow-lg inline-flex flex-col gap-2 font-mono text-[clamp(1.125rem,1rem+0.6vw,1.5rem)] tracking-[-0.006em] text-fg no-underline transition-colors duration-220 ease-quart hover:text-accent focus-visible:text-accent"
			href={`mailto:${email}`}
		>
			{email}
			<span
				class="h-px origin-left bg-line transition-[transform,background-color] duration-400 ease-expo group-hover/mail:scale-x-105 group-hover/mail:bg-accent group-focus-visible/mail:scale-x-105 group-focus-visible/mail:bg-accent"
				aria-hidden="true"></span>
		</a>

		<div class="mt-flow-xl border-t border-line pt-flow-md">
			<h2 class="mt-0 mb-4.5 font-mono text-mono font-normal tracking-mono text-muted uppercase">
				{t.socialsLabel}
			</h2>
			<ul class="m-0 flex list-none flex-wrap gap-x-10 gap-y-3 p-0" role="list">
				{
					socials.map((social) => (
						<li>
							<a
								class="group/social inline-flex items-center gap-2 text-[clamp(1.25rem,1.05rem+0.8vw,1.625rem)] font-semibold tracking-[-0.02em] text-fg no-underline transition-colors duration-220 ease-quart hover:text-accent focus-visible:text-accent"
								href={social.url}
								target="_blank"
								rel="noopener"
							>
								{social.label}
								<svg
									class="size-3.25 transition-transform duration-300 ease-expo group-hover/social:translate-x-0.5 group-hover/social:-translate-y-0.5 group-focus-visible/social:translate-x-0.5 group-focus-visible/social:-translate-y-0.5"
									viewBox="0 0 12 12"
									aria-hidden="true"
								>
									<path
										d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"
										fill="none"
										stroke="currentColor"
										stroke-width="1.2"
									/>
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</main>

	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initMotion } from '../scripts/motion';

	initTheme();
	initNav();
	initMotion();
</script>
