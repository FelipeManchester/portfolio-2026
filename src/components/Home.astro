---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Hero from './hero/Hero.astro';
import Work from './sections/Work.astro';
import Skills from './sections/Skills.astro';
import Journal from './sections/Journal.astro';
import Footer from './Footer.astro';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

/** The site's own title and meta description — the home page is the site root. */
const copy: Record<Locale, { title: string; description: string }> = {
	en: {
		title: 'Felipe Manchester — Full-stack developer',
		description:
			'Full-stack developer building fast, accessible web products with React, Next.js, Astro and TypeScript.',
	},
	pt: {
		title: 'Felipe Manchester — Desenvolvedor full-stack',
		description:
			'Desenvolvedor full-stack criando produtos web rápidos e acessíveis com React, Next.js, Astro e TypeScript.',
	},
};

const { locale } = Astro.props;
const t = copy[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />
	<Hero locale={locale} />
	<Work locale={locale} />
	<Skills locale={locale} />
	<Journal locale={locale} />
	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initTagline } from '../scripts/tagline';
	import { initMagnetic } from '../scripts/magnetic';
	import { initTilt } from '../scripts/tilt';
	import { initConfetti } from '../scripts/confetti';
	import { initMotion } from '../scripts/motion';

	// Interaction that must be ready the moment the visitor acts.
	initTheme();
	initNav();
	initTagline();
	initMagnetic();
	initTilt();
	initConfetti();

	// Scroll machinery is deferred and self-gating; see motion.ts.
	initMotion();
</script>
