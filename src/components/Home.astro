---
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from './background/Backdrop.astro';
import GridField from './background/GridField.astro';
import MeshCanvas from './background/MeshCanvas.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Hero from './hero/Hero.astro';
import { copy, type Locale } from '../content/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
	<Backdrop />
	<GridField />
	<MeshCanvas />
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />
	<Hero locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initTagline } from '../scripts/tagline';
	import { initMagnetic } from '../scripts/magnetic';
	import { initMotion } from '../scripts/motion';

	// Interaction that must be ready the moment the visitor acts.
	initTheme();
	initNav();
	initTagline();
	initMagnetic();

	// Scroll machinery is deferred and self-gating; see motion.ts.
	initMotion();
</script>
