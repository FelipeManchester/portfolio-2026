---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import Footer from './Footer.astro';
import { shared } from '../content/shared';
import type { Project } from '../lib/storyblok';
import { localePath, type Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
	project: Project;
}

/** The way back to the register this project was opened from. */
const back: Record<Locale, string> = { en: 'All work', pt: 'Todos os trabalhos' };

const { locale, project } = Astro.props;
const t = shared[locale];
const base = localePath('/trabalhos', locale);
const title = `${project.name} | ${t.trabalhosTitle}`;
---

<BaseLayout locale={locale} title={title} description={project.summary}>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />

	<section
		class="relative z-1 mx-auto max-w-detail px-frame pt-page-top pb-section"
		id="main"
		aria-labelledby="trabalho-name"
	>
		<a
			class="group/back inline-flex items-center gap-2 font-mono text-mono tracking-mono text-muted uppercase no-underline transition-colors duration-220 ease-quart hover:text-accent focus-visible:text-accent"
			href={base}
			data-reveal
		>
			<svg
				class="size-2.5 rotate-225 transition-transform duration-260 ease-quart group-hover/back:-translate-x-0.5 group-hover/back:translate-y-0.5 group-focus-visible/back:-translate-x-0.5 group-focus-visible/back:translate-y-0.5"
				viewBox="0 0 12 12"
				aria-hidden="true"
			>
				<path d="M9.5 2.5 2.5 9.5M8 9.5H2.5V4" fill="none" stroke="currentColor" stroke-width="1.2"
				></path>
			</svg>
			{back[locale]}
		</a>

		<header class="mt-flow-md" data-reveal>
			<div class="flex items-center justify-between gap-4 max-[720px]:flex-wrap">
				<span class="font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
					{project.year}
				</span>
				{
					project.url && (
						<a
							class="group/visit inline-flex [translate:var(--mx,0)_var(--my,0)] items-center gap-2 rounded-full border border-transparent bg-fg px-4.5 py-2.5 text-sm font-medium tracking-[-0.008em] whitespace-nowrap text-bg no-underline transition-[background-color,color] duration-220 ease-quart hover:bg-accent hover:text-white focus-visible:bg-accent focus-visible:text-white"
							href={project.url}
							target="_blank"
							rel="noopener"
							data-magnetic
						>
							{t.visitSite}
							<svg
								class="size-2.75 transition-[translate] duration-260 ease-quart group-hover/visit:translate-x-0.5 group-hover/visit:-translate-y-0.5 group-focus-visible/visit:translate-x-0.5 group-focus-visible/visit:-translate-y-0.5"
								viewBox="0 0 12 12"
								aria-hidden="true"
							>
								<path
									d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"
									fill="none"
									stroke="currentColor"
									stroke-width="1.2"
								/>
							</svg>
						</a>
					)
				}
			</div>

			<h1
				class="mt-3 mb-0 text-title leading-none font-semibold tracking-[-0.035em] text-balance"
				id="trabalho-name"
			>
				{project.name}
			</h1>

			<ul class="mt-5 flex list-none flex-wrap gap-x-2 gap-y-1.5 p-0" role="list">
				{
					project.stack.map((item) => (
						<li class="rounded-full border border-line px-2 py-0.5 font-mono text-mono tracking-mono text-muted uppercase">
							{item}
						</li>
					))
				}
			</ul>
		</header>

		<div class="relative mt-flow-lg aspect-16/10 overflow-hidden border border-line bg-bg" data-reveal>
			<div class="hatch absolute inset-0 grid place-items-center" aria-hidden="true">
				<span
					class="text-[clamp(3rem,8vw,5rem)] font-semibold tracking-[-0.03em] text-muted opacity-50"
				>
					{project.name.charAt(0)}
				</span>
			</div>
			{
				(project.poster || project.video) && (
					<video
						class="absolute inset-0 h-full w-full object-cover [&[hidden]]:hidden"
						autoplay
						muted
						loop
						playsinline
						preload="auto"
						poster={project.poster ?? undefined}
						aria-hidden="true"
					>
						{project.video && <source src={project.video} type="video/mp4" />}
					</video>
				)
			}
		</div>

		<p class="mt-flow-lg max-w-[62ch] text-prose leading-[1.65] text-muted text-pretty" data-reveal>
			{project.description}
		</p>
	</section>

	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initMagnetic } from '../scripts/magnetic';
	import { initMotion } from '../scripts/motion';

	initTheme();
	initNav();
	initMagnetic();
	initMotion();
</script>
