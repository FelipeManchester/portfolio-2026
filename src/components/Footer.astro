---
import { copy, type Locale } from '../content/site';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
const year = new Date().getFullYear();
---

{/* Bottom padding clears the fixed frame's inset. */}
<footer
	class="relative z-1 mx-auto flex max-w-page flex-wrap items-center gap-x-6 gap-y-3 border-t border-line px-frame pt-6 pb-[calc(var(--frame-inset)+2.5rem)]"
>
	<p class="m-0 font-mono text-mono tracking-mono text-muted uppercase">{t.footerNote}</p>
	<p class="m-0 font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
		&copy; {year}
	</p>
	<a
		class="m-0 ml-auto font-mono text-mono tracking-mono text-muted uppercase no-underline transition-colors duration-220 ease-quart hover:text-accent focus-visible:text-accent"
		href="#main"
	>
		{t.backToTop}
	</a>
</footer>
