---
import { copy, type Locale } from '../../content/site';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
---

{/* Labels ride on the element so theme.ts can relabel without importing copy. */}
<button
	type="button"
	class="grid size-8 cursor-pointer place-items-center rounded-full border-0 bg-none p-0 text-muted transition-colors duration-200 ease-linear hover:text-fg"
	data-theme-toggle
	data-label-dark={t.themeToDark}
	data-label-light={t.themeToLight}
	aria-label={t.themeToDark}
>
	{/* A disc whose lit half rotates across — a phase, not a sun and a moon. */}
	<svg
		class="size-4.25 rotate-0 transition-[rotate] duration-620 ease-quart dark:rotate-180"
		viewBox="0 0 24 24"
		aria-hidden="true"
		focusable="false"
	>
		<circle cx="12" cy="12" r="7.25" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
		<path d="M12 4.75a7.25 7.25 0 0 0 0 14.5z" fill="currentColor"></path>
	</svg>
</button>
