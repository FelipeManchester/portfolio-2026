---
import ThemeToggle from './ThemeToggle.astro';
import { socials, whatsappUrl } from '../../content/shared';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

/**
 * The menu itself. Hrefs are authored locale-neutral — the pt routes, since
 * those are the ones served from the root — and prefixed below, so a Portuguese
 * visitor never gets dropped onto an English route. Order differs between the
 * two languages on purpose; it is what each version was written with.
 */
const copy: Record<
	Locale,
	{ navLabel: string; menuOpen: string; menuClose: string; whatsapp: string; nav: { label: string; href: string }[] }
> = {
	en: {
		navLabel: 'Main',
		menuOpen: 'Open menu',
		menuClose: 'Close menu',
		whatsapp: 'WhatsApp',
		nav: [
			{ label: 'Home', href: '/' },
			{ label: 'Projects', href: '/trabalhos' },
			{ label: 'Blog', href: '/blog' },
			{ label: 'About', href: '/sobre' },
			{ label: 'Contact', href: '/contato' },
		],
	},
	pt: {
		navLabel: 'Principal',
		menuOpen: 'Abrir menu',
		menuClose: 'Fechar menu',
		whatsapp: 'WhatsApp',
		nav: [
			{ label: 'Início', href: '/' },
			{ label: 'Trabalhos', href: '/trabalhos' },
			{ label: 'Sobre', href: '/sobre' },
			{ label: 'Contato', href: '/contato' },
			{ label: 'Blog', href: '/blog' },
		],
	},
};

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
const current = Astro.url.pathname;

const items = t.nav.map((item) => ({
	...item,
	href: localePath(item.href, locale),
}));
---

{/* Watched by an IntersectionObserver to drive the scrolled state. */}
<div data-nav-sentinel aria-hidden="true"></div>

<header
	class="group fixed top-11 min-[600px]:top-[clamp(0.75rem,2vw,1.5rem)] left-1/2 z-50 -translate-x-1/2 transition-[translate] duration-300 ease-quart data-hidden:-translate-y-[calc(100%+2rem)]"
	data-nav
>
	{/*
	  Glass only at rest, floating over the hero. Past that — `group-data-scrolled`
	  — there is page content underneath instead of empty space, so the pill goes
	  fully opaque rather than letting text show through blurred; the backdrop
	  filters are dropped in that state since they'd have nothing left to do.
	*/}
	<nav
		class="relative flex items-center gap-1 rounded-full border border-line bg-bg/72 py-1.75 pr-2 pl-3.5 shadow-pill backdrop-blur-md backdrop-saturate-[1.4] transition-[padding,background-color,box-shadow,backdrop-filter] duration-300 ease-quart group-data-scrolled:bg-bg group-data-scrolled:py-1.25 group-data-scrolled:shadow-pill-scrolled group-data-scrolled:backdrop-blur-none group-data-scrolled:backdrop-saturate-100 max-[720px]:px-2"
		aria-label={t.navLabel}
	>
		{/*
		  One <ul> serves as the inline list on desktop and the drop panel below
		  720px. It is centred under the pill with a negative margin rather than a
		  transform, so the open/close animation keeps `translate` to itself.
		*/}
		<ul
			class="m-0 flex list-none items-center gap-0.5 p-0 max-[720px]:absolute max-[720px]:top-[calc(100%+0.5rem)] max-[720px]:left-1/2 max-[720px]:-ms-26 max-[720px]:w-52 max-[720px]:origin-top max-[720px]:-translate-y-1.5 max-[720px]:scale-[0.98] max-[720px]:flex-col max-[720px]:items-stretch max-[720px]:gap-0 max-[720px]:rounded-[1.25rem] max-[720px]:border max-[720px]:border-line max-[720px]:bg-bg/92 max-[720px]:p-2 max-[720px]:opacity-0 max-[720px]:shadow-panel max-[720px]:backdrop-blur-[20px] max-[720px]:backdrop-saturate-[1.6] max-[720px]:transition-[opacity,translate,scale] max-[720px]:duration-260 max-[720px]:ease-quart max-[720px]:data-open:translate-y-0 max-[720px]:data-open:scale-100 max-[720px]:data-open:opacity-100"
			id="nav-menu"
			data-menu-panel
		>
			{
				items.map((item) => (
					<li>
						<a
							href={item.href}
							class="block rounded-full px-2.75 py-1.5 text-sm font-medium tracking-[-0.006em] whitespace-nowrap text-muted no-underline transition-[color,background-color] duration-180 ease-linear hover:bg-fg/5 hover:text-fg aria-[current=page]:text-fg max-[720px]:px-3 max-[720px]:py-2.5 max-[720px]:text-base"
							aria-current={item.href === current ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>

		{/* The disclosure button only exists at the collapsed breakpoint. */}
		<button
			type="button"
			class="group/trigger hidden size-8 cursor-pointer flex-col justify-center gap-1 border-0 bg-none p-0 max-[720px]:flex"
			data-menu-trigger
			aria-expanded="false"
			aria-controls="nav-menu"
			aria-label={t.menuOpen}
			data-label-open={t.menuOpen}
			data-label-close={t.menuClose}
		>
			<span
				class="mx-auto h-[1.25px] w-3.75 bg-muted transition-[translate,rotate,background-color] duration-320 ease-quart group-hover/trigger:bg-fg group-aria-expanded/trigger:translate-y-[2.625px] group-aria-expanded/trigger:rotate-45"
			></span>
			<span
				class="mx-auto h-[1.25px] w-3.75 bg-muted transition-[translate,rotate,background-color] duration-320 ease-quart group-hover/trigger:bg-fg group-aria-expanded/trigger:translate-y-[-2.625px] group-aria-expanded/trigger:-rotate-45"
			></span>
		</button>

		<span class="mx-1.25 h-4.5 w-px bg-line" aria-hidden="true"></span>

		{
			socials.map((social) => (
				<a
					class="grid size-8 place-items-center rounded-full text-muted no-underline transition-colors duration-200 ease-linear hover:text-fg"
					href={social.url}
					target="_blank"
					rel="noopener"
					aria-label={social.label}
				>
					{social.label === 'GitHub' ? (
						<svg
							class="size-4"
							fill="currentColor"
							viewBox="-0.5 -0.5 17 17"
							aria-hidden="true"
							focusable="false"
						>
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
						</svg>
					) : (
						<svg
							class="size-4"
							fill="currentColor"
							viewBox="0 0 16 16"
							aria-hidden="true"
							focusable="false"
						>
							<path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
						</svg>
					)}
				</a>
			))
		}

		<a
			class="grid size-8 place-items-center rounded-full text-muted no-underline transition-colors duration-200 ease-linear hover:text-fg"
			href={whatsappUrl(locale)}
			target="_blank"
			rel="noopener"
			aria-label={t.whatsapp}
		>
			<svg class="size-4" fill="currentColor" viewBox="-0.5 -0.5 17 17" aria-hidden="true" focusable="false">
				<path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232" />
			</svg>
		</a>

		<span class="mx-1.25 h-4.5 w-px bg-line" aria-hidden="true"></span>
		<ThemeToggle locale={locale} />
	</nav>
</header>
