---
import ThemeToggle from './ThemeToggle.astro';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

/**
 * The menu itself. Hrefs are authored locale-neutral — the pt routes, since
 * those are the ones served from the root — and prefixed below, so a Portuguese
 * visitor never gets dropped onto an English route. Order differs between the
 * two languages on purpose; it is what each version was written with.
 */
const copy: Record<Locale, { navLabel: string; menuOpen: string; menuClose: string; nav: { label: string; href: string }[] }> = {
	en: {
		navLabel: 'Main',
		menuOpen: 'Open menu',
		menuClose: 'Close menu',
		nav: [
			{ label: 'Home', href: '/' },
			{ label: 'Projects', href: '/trabalhos' },
			{ label: 'Blog', href: '/blog' },
			{ label: 'About', href: '/sobre' },
			{ label: 'Contact', href: '/contato' },
		],
	},
	pt: {
		navLabel: 'Principal',
		menuOpen: 'Abrir menu',
		menuClose: 'Fechar menu',
		nav: [
			{ label: 'Início', href: '/' },
			{ label: 'Trabalhos', href: '/trabalhos' },
			{ label: 'Sobre', href: '/sobre' },
			{ label: 'Contato', href: '/contato' },
			{ label: 'Blog', href: '/blog' },
		],
	},
};

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
const current = Astro.url.pathname;

const items = t.nav.map((item) => ({
	...item,
	href: localePath(item.href, locale),
}));
---

{/* Watched by an IntersectionObserver to drive the scrolled state. */}
<div data-nav-sentinel aria-hidden="true"></div>

<header
	class="group fixed top-[clamp(0.75rem,2vw,1.5rem)] left-1/2 z-50 -translate-x-1/2 transition-[translate] duration-300 ease-quart data-hidden:-translate-y-[calc(100%+2rem)]"
	data-nav
>
	{/*
	  Glass only at rest, floating over the hero. Past that — `group-data-scrolled`
	  — there is page content underneath instead of empty space, so the pill goes
	  fully opaque rather than letting text show through blurred; the backdrop
	  filters are dropped in that state since they'd have nothing left to do.
	*/}
	<nav
		class="relative flex items-center gap-1 rounded-full border border-line bg-bg/72 py-1.75 pr-2 pl-3.5 shadow-pill backdrop-blur-md backdrop-saturate-[1.4] transition-[padding,background-color,box-shadow,backdrop-filter] duration-300 ease-quart group-data-scrolled:bg-bg group-data-scrolled:py-1.25 group-data-scrolled:shadow-pill-scrolled group-data-scrolled:backdrop-blur-none group-data-scrolled:backdrop-saturate-100 max-[720px]:px-2"
		aria-label={t.navLabel}
	>
		{/*
		  One <ul> serves as the inline list on desktop and the drop panel below
		  720px. It is centred under the pill with a negative margin rather than a
		  transform, so the open/close animation keeps `translate` to itself.
		*/}
		<ul
			class="m-0 flex list-none items-center gap-0.5 p-0 max-[720px]:absolute max-[720px]:top-[calc(100%+0.5rem)] max-[720px]:left-1/2 max-[720px]:-ms-26 max-[720px]:w-52 max-[720px]:origin-top max-[720px]:-translate-y-1.5 max-[720px]:scale-[0.98] max-[720px]:flex-col max-[720px]:items-stretch max-[720px]:gap-0 max-[720px]:rounded-[1.25rem] max-[720px]:border max-[720px]:border-line max-[720px]:bg-bg/92 max-[720px]:p-2 max-[720px]:opacity-0 max-[720px]:shadow-panel max-[720px]:backdrop-blur-[20px] max-[720px]:backdrop-saturate-[1.6] max-[720px]:transition-[opacity,translate,scale] max-[720px]:duration-260 max-[720px]:ease-quart max-[720px]:data-open:translate-y-0 max-[720px]:data-open:scale-100 max-[720px]:data-open:opacity-100"
			id="nav-menu"
			data-menu-panel
		>
			{
				items.map((item) => (
					<li>
						<a
							href={item.href}
							class="block rounded-full px-2.75 py-1.5 text-sm font-medium tracking-[-0.006em] whitespace-nowrap text-muted no-underline transition-[color,background-color] duration-180 ease-linear hover:bg-fg/5 hover:text-fg aria-[current=page]:text-fg max-[720px]:px-3 max-[720px]:py-2.5 max-[720px]:text-base"
							aria-current={item.href === current ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>

		{/* The disclosure button only exists at the collapsed breakpoint. */}
		<button
			type="button"
			class="group/trigger hidden size-8 cursor-pointer flex-col justify-center gap-1 border-0 bg-none p-0 max-[720px]:flex"
			data-menu-trigger
			aria-expanded="false"
			aria-controls="nav-menu"
			aria-label={t.menuOpen}
			data-label-open={t.menuOpen}
			data-label-close={t.menuClose}
		>
			<span
				class="mx-auto h-[1.25px] w-3.75 bg-muted transition-[translate,rotate,background-color] duration-320 ease-quart group-hover/trigger:bg-fg group-aria-expanded/trigger:translate-y-[2.625px] group-aria-expanded/trigger:rotate-45"
			></span>
			<span
				class="mx-auto h-[1.25px] w-3.75 bg-muted transition-[translate,rotate,background-color] duration-320 ease-quart group-hover/trigger:bg-fg group-aria-expanded/trigger:translate-y-[-2.625px] group-aria-expanded/trigger:-rotate-45"
			></span>
		</button>

		<span class="mx-1.25 h-4.5 w-px bg-line" aria-hidden="true"></span>
		<ThemeToggle locale={locale} />
	</nav>
</header>
