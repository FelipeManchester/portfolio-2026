---
import ThemeToggle from './ThemeToggle.astro';
import { copy, type Locale } from '../../content/site';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy[locale];
const current = Astro.url.pathname;
---

{/* Watched by an IntersectionObserver to drive the scrolled state. */}
<div data-nav-sentinel aria-hidden="true"></div>

<header class="nav" data-nav>
	<nav class="nav__pill" aria-label={t.navLabel}>
		<ul class="nav__list" id="nav-menu" data-menu-panel>
			{
				t.nav.map((item) => (
					<li>
						<a
							href={item.href}
							class="nav__link"
							aria-current={item.href === current ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>

		<button
			type="button"
			class="nav__trigger"
			data-menu-trigger
			aria-expanded="false"
			aria-controls="nav-menu"
			aria-label={t.menuOpen}
			data-label-open={t.menuOpen}
			data-label-close={t.menuClose}
		>
			<span class="nav__bar"></span>
			<span class="nav__bar"></span>
		</button>

		<span class="nav__rule" aria-hidden="true"></span>
		<ThemeToggle locale={locale} />
	</nav>
</header>

<style>
	.nav {
		position: fixed;
		top: clamp(0.75rem, 2vw, 1.5rem);
		left: 50%;
		z-index: 50;
		translate: -50% 0;
	}

	.nav__pill {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.4375rem 0.5rem 0.4375rem 0.875rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in oklab, var(--bg) 72%, transparent);
		backdrop-filter: blur(12px) saturate(1.4);
		-webkit-backdrop-filter: blur(12px) saturate(1.4);
		box-shadow: 0 1px 2px color-mix(in oklab, var(--fg) 4%, transparent);
		transition:
			padding 420ms var(--ease-out-quart),
			background-color 300ms linear,
			box-shadow 300ms linear,
			backdrop-filter 300ms linear;
	}

	/* Scrolled: tighter, and the glass reads more clearly against content. */
	.nav[data-scrolled] .nav__pill {
		padding-block: 0.3125rem;
		background: color-mix(in oklab, var(--bg) 88%, transparent);
		backdrop-filter: blur(20px) saturate(1.6);
		-webkit-backdrop-filter: blur(20px) saturate(1.6);
		box-shadow:
			0 1px 2px color-mix(in oklab, var(--fg) 5%, transparent),
			0 10px 30px -18px color-mix(in oklab, var(--fg) 45%, transparent);
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__link {
		display: block;
		padding: 0.375rem 0.6875rem;
		border-radius: 999px;
		color: var(--fg-muted);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: -0.006em;
		text-decoration: none;
		white-space: nowrap;
		transition:
			color 180ms linear,
			background-color 180ms linear;
	}

	.nav__link:hover {
		color: var(--fg);
		background: color-mix(in oklab, var(--fg) 5%, transparent);
	}

	.nav__link[aria-current='page'] {
		color: var(--fg);
	}

	.nav__rule {
		width: 1px;
		height: 1.125rem;
		margin-inline: 0.3125rem;
		background: var(--line);
	}

	/* The disclosure button only exists at the collapsed breakpoint. */
	.nav__trigger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.nav__bar {
		width: 15px;
		height: 1.25px;
		margin-inline: auto;
		background: var(--fg-muted);
		transition:
			translate 320ms var(--ease-out-quart),
			rotate 320ms var(--ease-out-quart),
			background-color 180ms linear;
	}

	.nav__trigger:hover .nav__bar {
		background: var(--fg);
	}

	.nav__trigger[aria-expanded='true'] .nav__bar:first-child {
		translate: 0 2.625px;
		rotate: 45deg;
	}

	.nav__trigger[aria-expanded='true'] .nav__bar:last-child {
		translate: 0 -2.625px;
		rotate: -45deg;
	}

	@media (max-width: 720px) {
		.nav__pill {
			padding: 0.4375rem 0.5rem;
		}

		.nav__trigger {
			display: flex;
		}

		.nav__list {
			/* Centred under the pill with margin rather than a transform, so the
			   open/close animation keeps `translate` to itself. */
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 50%;
			width: 13rem;
			margin-inline-start: -6.5rem;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem;
			border: 1px solid var(--line);
			border-radius: 1.25rem;
			background: color-mix(in oklab, var(--bg) 92%, transparent);
			backdrop-filter: blur(20px) saturate(1.6);
			-webkit-backdrop-filter: blur(20px) saturate(1.6);
			box-shadow: 0 20px 40px -24px color-mix(in oklab, var(--fg) 50%, transparent);
			opacity: 0;
			translate: 0 -6px;
			scale: 0.98;
			transform-origin: top center;
			transition:
				opacity 260ms var(--ease-out-quart),
				translate 260ms var(--ease-out-quart),
				scale 260ms var(--ease-out-quart);
		}

		.nav__list[data-open] {
			opacity: 1;
			translate: 0 0;
			scale: 1;
		}

		.nav__link {
			padding: 0.625rem 0.75rem;
			font-size: 0.9375rem;
		}
	}
</style>
