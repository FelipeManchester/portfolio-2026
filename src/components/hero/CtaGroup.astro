---
import { copy, type Locale } from '../../content/site';
import { localePath } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];

// Prefixed like the nav, so these never jump the visitor to another language.
const projectsHref = localePath('/projects', locale);
const contactHref = localePath('/contact', locale);
---

<div class="cta reveal">
	<a class="cta__button cta__button--primary" href={projectsHref} data-magnetic>
		<span class="cta__label">{t.ctaPrimary}</span>
	</a>

	<a class="cta__button cta__button--secondary" href={contactHref} data-magnetic>
		<span class="cta__label">{t.ctaSecondary}</span>
		<svg class="cta__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
			<path
				d="M3 8h10M9 4l4 4-4 4"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</a>
</div>

<style>
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		/* Padding gives the reveal's clip-path room to contain the buttons'
		   drop shadows; the negative margin cancels it so layout is unchanged. */
		padding: 1.5rem;
		margin: -1.5rem;
		animation: cta-in 900ms var(--ease-out-expo) 840ms both;
	}

	.cta__button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.875rem 1.5rem;
		border: 1px solid transparent;
		border-radius: 999px;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.008em;
		text-decoration: none;
		white-space: nowrap;
		/* Written by magnetic.ts; defaulted so the rule is valid without it. */
		transform: translate3d(var(--mx, 0), var(--my, 0), 0);
		transition:
			background-color 220ms var(--ease-out-quart),
			border-color 220ms var(--ease-out-quart),
			color 220ms var(--ease-out-quart),
			box-shadow 220ms var(--ease-out-quart);
	}

	.cta__button--primary {
		background: var(--fg);
		color: var(--bg);
		box-shadow:
			0 1px 2px color-mix(in oklab, var(--fg) 8%, transparent),
			0 10px 26px -14px color-mix(in oklab, var(--fg) 55%, transparent);
	}

	.cta__button--primary:hover {
		background: var(--accent);
		color: #ffffff;
		box-shadow:
			0 1px 2px color-mix(in oklab, var(--accent) 14%, transparent),
			0 14px 30px -14px color-mix(in oklab, var(--accent) 60%, transparent);
	}

	.cta__button--secondary {
		border-color: var(--line);
		/* Same glass vocabulary as the nav pill: without an opaque-enough fill,
		   the grid field behind the hero shows straight through the outline. */
		background: color-mix(in oklab, var(--bg) 82%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: var(--fg);
	}

	.cta__button--secondary:hover {
		border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
		color: var(--accent);
	}

	.cta__arrow {
		width: 1rem;
		height: 1rem;
		transition: translate 260ms var(--ease-out-quart);
	}

	.cta__button--secondary:hover .cta__arrow {
		translate: 3px 0;
	}

	@keyframes cta-in {
		from {
			clip-path: inset(0 0 100% 0);
		}
		to {
			clip-path: inset(0);
		}
	}
</style>
