---
import type { Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

/**
 * `taglines` rotate visually; `staticLine` is the single sentence assistive
 * tech gets instead, so a screen reader is not read eight variations of the
 * same claim. Any number of lines works — the rotator counts them at runtime.
 */
const copy: Record<Locale, { staticLine: string; taglines: string[] }> = {
	en: {
		staticLine: 'Full-stack developer building digital products.',
		taglines: [
			'Building scalable web applications.',
			'Creating modern and responsive interfaces.',
			'Turning ideas into digital products.',
			'From prototype to production.',
			'Performance and SEO by design.',
			'Clean code. Thoughtful architecture.',
			'Crafting intuitive user experiences.',
			'Focused on quality and maintainability.',
		],
	},
	pt: {
		staticLine: 'Desenvolvedor full-stack construindo produtos digitais.',
		taglines: [
			'Construindo produtos digitais.',
			'Criando interfaces modernas.',
			'Desenvolvimento focado em performance.',
			'Da ideia à produção.',
			'Código limpo e escalável.',
			'Experiências web intuitivas.',
			'Performance, acessibilidade e SEO.',
			'Soluções para web moderna.',
		],
	},
};

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
---

<div class="tagline reveal">
	{/* One stable sentence for assistive tech; the rotator is decorative. */}
	<p class="sr-only">{t.staticLine}</p>

	{/*
	  The phrase list rides along as JSON so tagline.ts can type and delete its
	  way through all of them — the first one is plain text here, so it is
	  correct and readable with no JavaScript at all, and the script settles it
	  into character spans in place rather than replaying an entrance for it.
	*/}
	<p
		class="tagline__line"
		data-tagline
		data-tagline-phrases={JSON.stringify(t.taglines)}
		aria-hidden="true"
	>
		<span data-tagline-text>{t.taglines[0]}</span><span
			class="tagline__caret"
			data-tagline-caret></span>
	</p>
</div>

<style>
	.tagline {
		animation: tagline-in 900ms var(--ease-out-expo) 700ms both;
	}

	.tagline__line {
		margin: 0;
		color: var(--fg-muted);
		font-size: var(--step-tagline);
		line-height: 1.6;
		letter-spacing: -0.011em;
		/* Kept on one line at every width, so a phrase growing character by
		   character never wraps mid-type. */
		white-space: nowrap;
	}

	@keyframes tagline-in {
		from {
			clip-path: inset(0 0 100% 0);
			opacity: 0;
		}
		to {
			clip-path: inset(0 0 -0.35em 0);
			opacity: 1;
		}
	}

	/* Each character fades and lifts into place — the same settle the name's
	   own letters use behind the plotter line — and leaves the same way in
	   reverse, faster, since deleting reads better brisk than deliberate. */
	.tagline__char {
		display: inline-block;
		opacity: 0;
		transform: translate3d(0, 0.22em, 0);
		transition:
			opacity 220ms var(--ease-out-expo),
			transform 220ms var(--ease-out-expo);
	}

	.tagline__char.in {
		opacity: 1;
		transform: translate3d(0, 0, 0);
	}

	.tagline__char.out {
		opacity: 0;
		transform: translate3d(0, -0.18em, 0);
		transition-duration: 140ms;
	}

	/* A text caret, not a block cursor — solid while the line is actively
	   typing or deleting, blinking only while it sits still and holds. */
	.tagline__caret {
		display: inline-block;
		width: 2px;
		height: 1em;
		margin-left: 0.2em;
		vertical-align: -0.15em;
		background: var(--accent);
		animation: tagline-caret-blink 1s step-end infinite;
	}

	.tagline__caret.is-typing {
		animation-play-state: paused;
		opacity: 1;
	}

	@keyframes tagline-caret-blink {
		50% {
			opacity: 0;
		}
	}
</style>
