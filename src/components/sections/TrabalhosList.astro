---
import { shared } from '../../content/shared';
import { getProjects } from '../../lib/storyblok';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const copy: Record<Locale, { lead: string; view: string }> = {
	en: {
		lead: 'Every build worth showing, with the stack and the reasoning behind each one.',
		view: 'View project',
	},
	pt: {
		lead: 'Todos os projetos que valem a pena mostrar, com a stack e o raciocínio por trás de cada um.',
		view: 'Ver trabalho',
	},
};

const { locale = 'pt' } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
const base = localePath('/trabalhos', locale);
const projects = await getProjects(locale);
---

<main
	class="relative z-1 mx-auto max-w-page px-frame pt-page-top pb-section"
	id="main"
	aria-labelledby="trabalhos-label"
>
	<header class="flex items-center gap-3.5">
		<h1
			class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
			id="trabalhos-label"
		>
			{t.workLabel}
		</h1>
		<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
		<span
			class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
		>
			{String(projects.length).padStart(2, '0')}
		</span>
	</header>

	<p class="mt-flow-md max-w-[46ch] text-lead leading-[1.35] tracking-[-0.02em] text-balance">
		{t.lead}
	</p>

	{/*
	  A still, not the video — same reasoning as the home teaser (Work.astro):
	  every card here opens the project's own page, and that is where the video
	  autoplays.
	*/}
	<ul class="mt-flow-xl flex list-none flex-col p-0" role="list">
		{
			projects.map((project, index) => {
				return (
					<li class="border-b border-line" data-reveal>
						<a
							class="group/card grid grid-cols-[minmax(0,30%)_minmax(0,1fr)] items-center gap-[clamp(1.75rem,4vw,3.5rem)] py-[clamp(1.75rem,4vh,2.75rem)] text-inherit no-underline max-[720px]:grid-cols-1"
							href={`${base}/${project.slug}`}
						>
							<div
								class="relative aspect-16/10 overflow-hidden border border-line bg-bg transition-colors duration-260 ease-expo group-hover/card:border-accent group-focus-visible/card:border-accent"
							>
								<div class="hatch absolute inset-0 grid place-items-center" aria-hidden="true">
									<span class="text-[clamp(2rem,5vw,3rem)] font-semibold tracking-[-0.03em] text-muted opacity-50">
										{project.name.charAt(0)}
									</span>
								</div>
								{project.poster && (
									<img
										class="absolute inset-0 h-full w-full object-cover"
										src={project.poster}
										alt=""
										loading="lazy"
										decoding="async"
									/>
								)}
							</div>

							<div class="flex flex-col gap-3">
								<div class="flex items-center gap-4">
									<span class="font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
										{project.year}
									</span>
								</div>

								<h2 class="m-0 text-project-lg leading-[1.06] font-semibold tracking-[-0.03em] transition-colors duration-260 ease-expo group-hover/card:text-accent group-focus-visible/card:text-accent">
									{project.name}
								</h2>
								<p class="m-0 max-w-[52ch] leading-relaxed text-muted text-pretty">
									{project.summary}
								</p>

								<ul class="mt-1 flex list-none flex-wrap gap-x-2 gap-y-1.5 p-0" role="list">
									{project.stack.map((item) => (
										<li class="rounded-full border border-line px-2 py-0.5 font-mono text-mono tracking-mono text-muted uppercase">
											{item}
										</li>
									))}
								</ul>

								<span class="mt-2 inline-flex items-center gap-2 font-mono text-mono tracking-mono text-fg uppercase transition-colors duration-260 ease-expo group-hover/card:text-accent group-focus-visible/card:text-accent">
									{t.view}
									<svg
										class="size-2.75 transition-transform duration-300 ease-expo group-hover/card:translate-x-0.5 group-hover/card:-translate-y-0.5 group-focus-visible/card:translate-x-0.5 group-focus-visible/card:-translate-y-0.5"
										viewBox="0 0 12 12"
										aria-hidden="true"
									>
										<path
											d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"
											fill="none"
											stroke="currentColor"
											stroke-width="1.2"
										/>
									</svg>
								</span>
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>
</main>
