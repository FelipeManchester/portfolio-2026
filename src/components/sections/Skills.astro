---
import Section from './Section.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const copy: Record<Locale, { label: string; lead: string }> = {
	en: { label: 'Skills', lead: 'Technologies I use to turn ideas into products.' },
	pt: { label: 'Habilidades', lead: 'As tecnologias que utilizo para transformar ideias em produtos.' },
};

/**
 * Technology names are not translated, only the three category headings.
 * Pulled from the CV list rather than every tool he has touched: this is what
 * a recruiter scanning for a stack match is looking for.
 */
const skillGroups: { label: Record<Locale, string>; skills: string[] }[] = [
	{
		label: { en: 'Front-end', pt: 'Front-end' },
		skills: ['React', 'Next.js', 'Astro', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Sass'],
	},
	{
		label: { en: 'Back-end', pt: 'Back-end' },
		skills: ['Node.js', 'Express', 'PHP', 'REST APIs', 'GraphQL', 'MySQL', 'Firebase', 'Supabase'],
	},
	{
		label: { en: 'Tools & workflow', pt: 'Ferramentas' },
		skills: [
			'WordPress',
			'Sanity',
			'Wix',
			'Git',
			'Figma',
			'Jest',
			'CI/CD',
			'Vercel',
			'Netlify',
			'Claude Code',
			'Codex',
			'Antigravity',
			'n8n',
		],
	},
];

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
---

<Section id="skills" label={t.label} lead={t.lead}>
	{/*
	  Three groups, not one long list: front-end, back-end and tooling read as
	  different kinds of claim, and keeping them apart lets a recruiter scan for
	  the one column they actually came to check.
	*/}
	<div
		class="mt-flow-lg grid grid-cols-3 gap-[clamp(2rem,5vw,3.5rem)] border-t border-line pt-flow-md max-[860px]:grid-cols-1 max-[860px]:gap-[clamp(1.75rem,5vh,2.5rem)]"
	>
		{
			skillGroups.map((group) => (
				<div data-reveal>
					<h3 class="mt-0 mb-4.5 font-mono text-mono font-normal tracking-mono text-muted uppercase">
						{group.label[locale]}
					</h3>
					<ul class="m-0 flex list-none flex-wrap gap-x-2.5 gap-y-2 p-0" role="list">
						{group.skills.map((skill) => (
							<li class="rounded-full border border-line px-3 py-1.5 text-base tracking-[-0.006em] transition-[border-color,color] duration-220 ease-quart hover:border-[color-mix(in_oklab,var(--accent)_55%,var(--line))] hover:text-accent">
								{skill}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</Section>
