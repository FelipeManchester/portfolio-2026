---
/**
 * The shell every section below the hero shares: a mono label, a hairline that
 * runs to the right edge, and an optional count on the far side. Same drafting
 * vocabulary as the frame annotations and the About block, so the page reads as
 * one sheet rather than a stack of unrelated blocks.
 */

interface Props {
	id: string;
	label: string;
	lead?: string;
	/** Right-hand annotation — a real count, not decoration. */
	meta?: string;
}

const { id, label, lead, meta } = Astro.props;
---

<section
	class="relative z-1 mx-auto max-w-page px-frame py-section"
	id={id}
	aria-labelledby={`${id}-label`}
>
	<header class="flex items-center gap-3.5">
		<h2
			class="m-0 font-mono text-xl tracking-mono whitespace-nowrap text-muted uppercase"
			id={`${id}-label`}
			data-reveal
		>
			{label}
		</h2>
		<span class="h-px flex-1 origin-left bg-line" aria-hidden="true" data-reveal-rule></span>
		{
			meta && (
				<span
					class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
					data-reveal
				>
					{meta}
				</span>
			)
		}
	</header>

	{
		lead && (
			<p
				class="mt-flow-md max-w-[46ch] text-lead leading-[1.35] tracking-[-0.02em] text-balance"
				data-reveal
			>
				{lead}
			</p>
		)
	}

	<slot />
</section>
