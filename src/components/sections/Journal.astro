---
import Section from './Section.astro';
import { copy, posts, type Locale } from '../../content/site';
import { localePath } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];

const blogBase = localePath('/blog', locale);

// Formatted on the server: the date is the same for every visitor, so there is
// no reason to ship Intl work to the browser for it.
const dateFormat = new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'pt-BR', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<Section
	id="journal"
	label={t.journalLabel}
	lead={t.journalLead}
	meta={String(posts.length).padStart(2, '0')}
>
	{/*
	  Columns rather than another full-width register: two stacked registers in a
	  row would flatten the page's rhythm, and a teaser is short enough that it
	  does not need the measure. The 1px gap plus the shared background is what
	  draws the rules between columns.
	*/}
	<ul
		class="mt-flow-lg grid grid-cols-3 gap-px border-y border-line bg-line p-0 max-[860px]:grid-cols-1"
		role="list"
	>
		{
			posts.map((post) => (
				<li class="bg-bg" data-reveal>
					<a
						class="group/post flex h-full flex-col gap-4 px-[clamp(1.25rem,2.5vw,2rem)] py-[clamp(1.5rem,3vh,2.25rem)] text-inherit no-underline transition-colors duration-300 ease-expo hover:bg-accent/5 focus-visible:bg-accent/5"
						href={`${blogBase}/${post.slug}`}
					>
						<div class="flex items-center gap-3 font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
							<time datetime={post.date}>{dateFormat.format(new Date(post.date))}</time>
							<span class="text-accent">{post.tag}</span>
						</div>

						<h3 class="m-0 text-card leading-[1.22] font-semibold tracking-[-0.022em] text-balance transition-colors duration-260 ease-expo group-hover/post:text-accent group-focus-visible/post:text-accent">
							{post.title[locale]}
						</h3>

						{/* Pushed to the bottom of the cell so the three cells share a
						    baseline no matter how long the titles run. */}
						<span class="mt-auto flex items-center gap-3 font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
							{post.minutes} {t.readTime}
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<a
		class="group/all mt-flow-md inline-flex items-center gap-3.5 font-mono text-mono tracking-mono text-fg uppercase no-underline"
		href={blogBase}
		data-reveal
	>
		{t.journalAll}
		<span
			class="h-px w-[clamp(2.5rem,8vw,5rem)] origin-left bg-muted transition-[transform,background-color] duration-400 ease-expo group-hover/all:scale-x-150 group-hover/all:bg-accent group-focus-visible/all:scale-x-150 group-focus-visible/all:bg-accent"
			aria-hidden="true"></span>
	</a>
</Section>
