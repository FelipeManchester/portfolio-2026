---
import Section from './Section.astro';
import { copy, posts, type Locale } from '../../content/site';
import { localePath } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];

const blogBase = localePath('/blog', locale);

// Formatted on the server: the date is the same for every visitor, so there is
// no reason to ship Intl work to the browser for it.
const dateFormat = new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'pt-BR', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});
---

<Section
	id="journal"
	label={t.journalLabel}
	lead={t.journalLead}
	meta={String(posts.length).padStart(2, '0')}
>
	{/*
	  Columns rather than another full-width register: two stacked registers in a
	  row would flatten the page's rhythm, and a teaser is short enough that it
	  does not need the measure.
	*/}
	<ul class="journal" role="list">
		{
			posts.map((post) => (
				<li class="journal__item" data-reveal>
					<a class="journal__link" href={`${blogBase}/${post.slug}`}>
						<div class="journal__meta">
							<time datetime={post.date}>{dateFormat.format(new Date(post.date))}</time>
							<span class="journal__tag">{post.tag}</span>
						</div>

						<h3 class="journal__title">{post.title[locale]}</h3>

						<span class="journal__time">
							{post.minutes} {t.readTime}
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<a class="journal__all" href={blogBase} data-reveal>
		{t.journalAll}
		<span class="journal__all-rule" aria-hidden="true"></span>
	</a>
</Section>

<style>
	.journal {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		margin: clamp(2.5rem, 6vh, 4rem) 0 0;
		padding: 0;
		/* The 1px gap plus this background is what draws the rules between
		   columns — one border per cell would double up at every seam. */
		background: var(--line);
		border-block: 1px solid var(--line);
	}

	.journal__item {
		background: var(--bg);
	}

	.journal__link {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
		padding: clamp(1.5rem, 3vh, 2.25rem) clamp(1.25rem, 2.5vw, 2rem);
		color: inherit;
		text-decoration: none;
		transition: background-color 300ms var(--ease-out-expo);
	}

	.journal__link:hover,
	.journal__link:focus-visible {
		background: color-mix(in oklab, var(--accent) 5%, transparent);
	}

	.journal__meta,
	.journal__time {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: var(--step-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
	}

	.journal__tag {
		color: var(--accent);
	}

	.journal__title {
		margin: 0;
		font-size: clamp(1.125rem, 0.95rem + 0.7vw, 1.4375rem);
		font-weight: 600;
		line-height: 1.22;
		letter-spacing: -0.022em;
		text-wrap: balance;
		transition: color 260ms var(--ease-out-expo);
	}

	.journal__link:hover .journal__title,
	.journal__link:focus-visible .journal__title {
		color: var(--accent);
	}

	/* Pushes the reading time to the bottom of the cell so the three cells share
	   a baseline no matter how long the titles run. */
	.journal__time {
		margin-top: auto;
	}

	.journal__all {
		display: inline-flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: clamp(2rem, 5vh, 3rem);
		color: var(--fg);
		font-family: var(--font-mono);
		font-size: var(--step-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.journal__all-rule {
		width: clamp(2.5rem, 8vw, 5rem);
		height: 1px;
		background: var(--fg-muted);
		transform-origin: left center;
		transition:
			transform 400ms var(--ease-out-expo),
			background-color 260ms linear;
	}

	.journal__all:hover .journal__all-rule,
	.journal__all:focus-visible .journal__all-rule {
		transform: scaleX(1.5);
		background: var(--accent);
	}

	@media (max-width: 860px) {
		.journal {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
