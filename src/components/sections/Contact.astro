---
import { email, shared } from '../../content/shared';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

/** Flip to false the day he signs somewhere — the status pill reads from this. */
const availableForWork = true;

const copy: Record<Locale, { available: string; cta: string }> = {
	en: { available: 'Available for work', cta: 'Send a message' },
	pt: { available: 'Disponível para trabalho', cta: 'Enviar mensagem' },
};

const { locale = 'pt' } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
const contactHref = localePath('/contato', locale);
---

{/*
  The last beat of the page, so it gets the largest type after the name itself.
  The email is written out rather than hidden behind the button: a recruiter
  who wants to paste an address into their own client should not have to open a
  form to find it.
*/}
<section
	class="relative z-1 mx-auto max-w-page px-frame pt-section pb-[clamp(3.5rem,9vh,6rem)]"
	id="contact"
	aria-labelledby="contact-label"
>
	<header class="flex items-center gap-3.5">
		<h2
			class="m-0 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
			id="contact-label"
			data-reveal
		>
			{t.contactLabel}
		</h2>
		<span class="h-px flex-1 bg-line" aria-hidden="true"></span>
		{
			availableForWork && (
				<span
					class="m-0 inline-flex items-center gap-2 font-mono text-mono font-normal tracking-mono whitespace-nowrap text-muted uppercase"
					data-reveal
				>
					<span class="size-1.25 rounded-full bg-accent" aria-hidden="true" />
					{t.available}
				</span>
			)
		}
	</header>

	<p
		class="mt-flow-lg max-w-[14ch] text-statement leading-[0.95] font-semibold tracking-[-0.045em] text-balance"
		data-reveal
	>
		{t.contactHeadline}
	</p>
	<p class="mt-flow-sm max-w-[44ch] leading-[1.65] text-muted text-pretty" data-reveal>
		{t.contactBody}
	</p>

	<div class="mt-flow-md flex flex-wrap items-center gap-x-8 gap-y-5" data-reveal>
		{/*
		  Same pill as the hero's primary call to action — this is the same action,
		  so it should not be a different object.
		*/}
		<a
			class="inline-flex [translate:var(--mx,0)_var(--my,0)] items-center rounded-full bg-fg px-6 py-3.5 font-medium tracking-[-0.008em] whitespace-nowrap text-bg no-underline shadow-cta transition-[background-color,color,box-shadow] duration-220 ease-quart hover:bg-accent hover:text-white hover:shadow-cta-hover"
			href={contactHref}
			data-magnetic>{t.cta}</a
		>

		<a
			class="group/mail inline-flex flex-col gap-1.5 font-mono text-mono tracking-[0.06em] text-fg no-underline transition-colors duration-220 ease-quart hover:text-accent focus-visible:text-accent"
			href={`mailto:${email}`}
		>
			{email}
			<span
				class="h-px origin-left bg-line transition-[transform,background-color] duration-400 ease-expo group-hover/mail:bg-accent group-focus-visible/mail:bg-accent"
				aria-hidden="true"></span>
		</a>
	</div>
</section>
