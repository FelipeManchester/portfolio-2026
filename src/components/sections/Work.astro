---
import Section from './Section.astro';
import { shared } from '../../content/shared';
import { getFeaturedProjects } from '../../lib/storyblok';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const copy: Record<Locale, { lead: string; all: string; view: string }> = {
	en: {
		lead: 'Three builds that show the range — product, catalogue, and a site that lives or dies on search.',
		all: 'All projects',
		view: 'View project',
	},
	pt: {
		lead: 'Três trabalhos que mostram a variação — produto, catálogo e um site que depende de busca orgânica.',
		all: 'Ver Todos os trabalhos',
		view: 'Ver trabalho',
	},
};

const { locale = 'pt' } = Astro.props;
const t = { ...shared[locale], ...copy[locale] };
const projectsHref = localePath('/trabalhos', locale);
const projects = await getFeaturedProjects(locale);
---

<Section
	id="work"
	label={t.workLabel}
	lead={t.lead}
	meta={String(projects.length).padStart(2, '0')}
>
	{/*
	  Every card opens the project's own detail page, never the client's site
	  directly — the "visit site" link lives there instead, alongside the write-up.
	  The poster is a still image here; the video only plays on the detail page,
	  so the home page never carries autoplaying media.
	*/}
	<ul
		class="mt-flow-lg grid grid-cols-3 gap-[clamp(1.5rem,3vw,2rem)] p-0 max-[900px]:grid-cols-1"
		role="list"
	>
		{
			projects.map((project) => {
				const href = localePath(`/trabalhos/${project.slug}`, locale);

				return (
					<li>
						<a class="group/card flex h-full flex-col text-inherit no-underline" data-reveal href={href}>
							<div class="relative mb-4 aspect-16/10 overflow-hidden rounded-lg bg-bg">
								{/* The card's art until a real recording exists: an initial on a
								    hairline diagonal field, the same drafting-sheet vocabulary as
								    the rest of the page rather than a generic grey box. */}
								<div class="hatch absolute inset-0 grid place-items-center" aria-hidden="true">
									<span class="text-[clamp(2.5rem,6vw,3.5rem)] font-semibold tracking-[-0.03em] text-muted opacity-50">
										{project.name.charAt(0)}
									</span>
								</div>
								{project.poster && (
									<img
										class="absolute inset-0 h-full w-full object-cover"
										src={project.poster}
										alt=""
										loading="lazy"
										decoding="async"
									/>
								)}
							</div>

							<div class="flex flex-1 flex-col gap-2.5 p-card">
								<div class="flex items-center justify-between gap-4">
									<span class="font-mono text-mono tracking-mono text-muted uppercase tabular-nums">
										{project.year}
									</span>
									<span class="inline-flex items-center gap-1.5 font-mono text-mono tracking-mono whitespace-nowrap text-muted uppercase tabular-nums transition-colors duration-260 ease-expo group-hover/card:text-accent group-focus-visible/card:text-accent">
										{t.view}
										<svg
											class="size-2.75 transition-transform duration-300 ease-expo group-hover/card:translate-x-0.5 group-hover/card:-translate-y-0.5 group-focus-visible/card:translate-x-0.5 group-focus-visible/card:-translate-y-0.5"
											viewBox="0 0 12 12"
											aria-hidden="true"
										>
											<path
												d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"
												fill="none"
												stroke="currentColor"
												stroke-width="1.2"
											/>
										</svg>
									</span>
								</div>

								<h3 class="m-0 text-project leading-[1.08] font-semibold tracking-[-0.03em] transition-colors duration-260 ease-expo group-hover/card:text-accent group-focus-visible/card:text-accent">
									{project.name}
								</h3>
								<p class="m-0 text-[0.9375rem] leading-relaxed text-muted text-pretty">
									{project.summary}
								</p>

								<ul class="mt-auto flex flex-wrap gap-x-2 gap-y-1.5 pt-1.5" role="list">
									{project.stack.map((item) => (
										<li class="rounded-full border border-line px-2 py-0.5 font-mono text-mono tracking-mono text-muted uppercase">
											{item}
										</li>
									))}
								</ul>
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>

	<a
		class="group/all mt-flow-md inline-flex items-center gap-3.5 font-mono text-mono tracking-mono text-fg uppercase no-underline"
		href={projectsHref}
		data-reveal
	>
		{t.all}
		<span
			class="h-px w-[clamp(2.5rem,8vw,5rem)] origin-left bg-muted transition-[transform,background-color] duration-400 ease-expo group-hover/all:scale-x-150 group-hover/all:bg-accent group-focus-visible/all:scale-x-150 group-focus-visible/all:bg-accent"
			aria-hidden="true"></span>
	</a>
</Section>
