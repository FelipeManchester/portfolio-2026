---
import Section from './Section.astro';
import { copy, projects, type Locale } from '../../content/site';
import { localePath } from '../../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'pt' } = Astro.props;
const t = copy[locale];
const projectsHref = localePath('/trabalhos', locale);
---

<Section
	id="work"
	label={t.workLabel}
	lead={t.workLead}
	meta={String(projects.length).padStart(2, '0')}
>
	{/*
	  Each card looks for /projects/<slug>.mp4 and /projects/<slug>-poster.jpg —
	  drop a short muted loop (~6-10s) and its first frame in public/projects/
	  under those names and it plays with no code change. Until then the video's
	  own `error` event hides it (see preview.ts) and the lettered tile behind it
	  stays as the card's art.
	*/}
	<ul class="work" role="list">
		{
			projects.map((project) => {
				const Row = project.url ? 'a' : 'div';
				const rowProps = project.url
					? { href: project.url, target: '_blank', rel: 'noopener' }
					: {};
				const mediaBase = `/projects/${project.slug}`;

				return (
					<li class="work__item">
						<Row class="work__card" data-preview data-reveal {...rowProps}>
							<div class="work__media">
								<div class="work__media-fallback" aria-hidden="true">
									<span>{project.name.charAt(0)}</span>
								</div>
								<video
									class="work__media-video"
									muted
									loop
									playsinline
									preload="none"
									poster={`${mediaBase}-poster.jpg`}
									aria-hidden="true"
								>
									<source src={`${mediaBase}.mp4`} type="video/mp4" />
								</video>
							</div>

							<div class="work__body">
								<div class="work__meta">
									<span class="work__year">{project.year}</span>
									<span class="work__action" data-soon={project.url ? undefined : ''}>
										{project.url ? t.visitSite : t.soon}
										{project.url && (
											<svg class="work__arrow" viewBox="0 0 12 12" aria-hidden="true">
												<path
													d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8"
													fill="none"
													stroke="currentColor"
													stroke-width="1.2"
												/>
											</svg>
										)}
									</span>
								</div>

								<h3 class="work__name">{project.name}</h3>
								<p class="work__summary">{project.summary[locale]}</p>

								<ul class="work__stack" role="list">
									{project.stack.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						</Row>
					</li>
				);
			})
		}
	</ul>

	<a class="work__all" href={projectsHref} data-reveal>
		{t.workAll}
		<span class="work__all-rule" aria-hidden="true"></span>
	</a>
</Section>

<script>
	import { initPreviews } from '../../scripts/preview';
	initPreviews();
</script>

<style>
	.work {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		margin: clamp(2.5rem, 6vh, 4rem) 0 0;
		padding: 0;
		/* Same shared-background-as-rule trick as the journal grid: the 1px gap
		   plus this background draws every seam without doubling borders. */
		background: var(--line);
		border-block: 1px solid var(--line);
	}

	.work__item {
		background: var(--bg);
	}

	.work__card {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	/* --- Media ------------------------------------------------------------ */

	.work__media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--stage, var(--bg));
		border-bottom: 1px solid var(--line);
	}

	/* The card's art until a real recording exists: an initial on a hairline
	   diagonal field, the same drafting-sheet vocabulary as the rest of the
	   page rather than a generic grey box. */
	.work__media-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background-image: repeating-linear-gradient(
			-45deg,
			var(--line) 0,
			var(--line) 1px,
			transparent 1px,
			transparent 12px
		);
	}

	.work__media-fallback span {
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--fg-muted);
		opacity: 0.5;
	}

	.work__media-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work__media-video[hidden] {
		display: none;
	}

	/* --- Body --------------------------------------------------------------- */

	.work__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.625rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.work__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.work__year,
	.work__action {
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: var(--step-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
	}

	.work__action {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		white-space: nowrap;
	}

	.work__action[data-soon] {
		opacity: 0.6;
	}

	.work__arrow {
		width: 11px;
		height: 11px;
		transition: transform 300ms var(--ease-out-expo);
	}

	.work__name {
		margin: 0;
		font-size: clamp(1.375rem, 1rem + 1.4vw, 1.875rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.03em;
		transition: color 260ms var(--ease-out-expo);
	}

	.work__summary {
		margin: 0;
		color: var(--fg-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.work__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.5rem;
		margin: auto 0 0;
		padding-top: 0.375rem;
	}

	.work__stack li {
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		font-size: var(--step-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Hover belongs to the whole card. */
	a.work__card:hover .work__name,
	a.work__card:focus-visible .work__name {
		color: var(--accent);
	}

	a.work__card:hover .work__action,
	a.work__card:focus-visible .work__action {
		color: var(--accent);
	}

	a.work__card:hover .work__arrow,
	a.work__card:focus-visible .work__arrow {
		transform: translate(2px, -2px);
	}

	/* --- All projects -------------------------------------------------------- */

	.work__all {
		display: inline-flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: clamp(2rem, 5vh, 3rem);
		color: var(--fg);
		font-family: var(--font-mono);
		font-size: var(--step-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.work__all-rule {
		width: clamp(2.5rem, 8vw, 5rem);
		height: 1px;
		background: var(--fg-muted);
		transform-origin: left center;
		transition:
			transform 400ms var(--ease-out-expo),
			background-color 260ms linear;
	}

	.work__all:hover .work__all-rule,
	.work__all:focus-visible .work__all-rule {
		transform: scaleX(1.5);
		background: var(--accent);
	}

	@media (max-width: 900px) {
		.work {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
