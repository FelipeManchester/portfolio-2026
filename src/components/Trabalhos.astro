---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './nav/Nav.astro';
import BlueprintFrame from './frame/BlueprintFrame.astro';
import TrabalhosList from './sections/TrabalhosList.astro';
import Footer from './Footer.astro';
import { shared } from '../content/shared';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

/** Only the meta description is page-specific; the title also suffixes each project. */
const description: Record<Locale, string> = {
	en: 'See some of the projects I built for clients, including institutional websites, landing pages and web applications, with details on the technologies used.',
	pt: 'Conheça alguns dos projetos que desenvolvi para clientes, incluindo sites institucionais, landing pages e aplicações web, com detalhes sobre as tecnologias utilizadas.',
};

const { locale } = Astro.props;
---

<BaseLayout
	locale={locale}
	title={shared[locale].trabalhosTitle}
	description={description[locale]}
>
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />
	<TrabalhosList locale={locale} />
	<Footer locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initMotion } from '../scripts/motion';

	initTheme();
	initNav();
	initMotion();
</script>
