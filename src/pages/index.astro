---
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/background/Backdrop.astro';
import MeshCanvas from '../components/background/MeshCanvas.astro';
import Nav from '../components/nav/Nav.astro';
import BlueprintFrame from '../components/frame/BlueprintFrame.astro';
import Hero from '../components/hero/Hero.astro';

const locale = 'en';
---

<BaseLayout
	locale={locale}
	title="Felipe Manchester — Full-stack developer"
	description="Full-stack developer building fast, accessible web products with React, Next.js, Astro and TypeScript."
>
	<Backdrop />
	<MeshCanvas />
	<BlueprintFrame locale={locale} />
	<Nav locale={locale} />
	<Hero locale={locale} />
</BaseLayout>

<script>
	import { initNav } from '../scripts/nav';
	import { initTheme } from '../scripts/theme';
	import { initTagline } from '../scripts/tagline';
	import { initMagnetic } from '../scripts/magnetic';
	import { initMotion } from '../scripts/motion';

	// Interaction that must be ready the moment the visitor acts.
	initTheme();
	initNav();
	initTagline();
	initMagnetic();

	// Scroll machinery is deferred and self-gating; see motion.ts.
	initMotion();
</script>
