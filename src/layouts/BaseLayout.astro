---
import { Font } from 'astro:assets';
import { localePath, locales, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	locale?: Locale;
}

/** The only string this layout owns: the first thing a keyboard user reaches. */
const skip: Record<Locale, string> = {
	en: 'Skip to content',
	pt: 'Pular para o conteúdo',
};

const { title, description, locale = 'en' } = Astro.props;

// Pairs the two language versions of whatever page this is. Absolute URLs are
// preferred for hreflang, but only once `site` is set in astro.config.mjs —
// without it Astro.site is undefined and absolutising here would bake the
// build machine's localhost address into production HTML.
const alternates = locales.map((code) => {
	const path = localePath(Astro.url.pathname, code);
	return { code, href: Astro.site ? new URL(path, Astro.site).href : path };
});
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		{alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />

		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

		{/* Resolve the theme before first paint so dark-mode reloads never flash white. */}
		<script is:inline>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {}
				const theme =
					stored ??
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
			})();
		</script>

		{/*
		  Cross-document View Transitions animate navigations on their own; where
		  they are missing (Firefox) a scripted crossfade stands in. Flagged here
		  rather than from the module script so the entry animation is already in
		  effect at first paint. `pageswap` ships alongside the cross-document
		  support, which makes it the closest thing to a direct feature test.
		*/}
		<script is:inline>
			if (!('onpageswap' in window)) document.documentElement.dataset.pageFade = '';
		</script>

		{/* Display face is the LCP element, so it preloads. The mono face is not. */}
		<Font cssVariable="--font-general-sans" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>

	<body>
		<a class="skip-link" href="#main">{skip[locale]}</a>
		<slot />

		{/* Every page uses this layout, so the fallback is wired once here rather
		    than repeated in each page's own script block. */}
		<script>
			import { initPageTransition } from '../scripts/page-transition';
			initPageTransition();
		</script>
	</body>
</html>
