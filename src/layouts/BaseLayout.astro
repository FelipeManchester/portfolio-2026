---
import { Font } from 'astro:assets';
import { copy, locales, type Locale } from '../content/site';
import { localePath } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	locale?: Locale;
}

const { title, description, locale = 'en' } = Astro.props;
const t = copy[locale];

// Pairs the two language versions of whatever page this is. Absolute URLs are
// preferred for hreflang, but only once `site` is set in astro.config.mjs —
// without it Astro.site is undefined and absolutising here would bake the
// build machine's localhost address into production HTML.
const alternates = locales.map((code) => {
	const path = localePath(Astro.url.pathname, code);
	return { code, href: Astro.site ? new URL(path, Astro.site).href : path };
});
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />

		{alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />

		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

		{/* Resolve the theme before first paint so dark-mode reloads never flash white. */}
		<script is:inline>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {}
				const theme =
					stored ??
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
			})();
		</script>

		{/* Display face is the LCP element, so it preloads. The mono face is not. */}
		<Font cssVariable="--font-general-sans" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>

	<body>
		<a class="skip-link" href="#main">{t.skip}</a>
		<slot />
	</body>
</html>
